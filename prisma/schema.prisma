model AvailabilityDay {
  id       String   @id @default(cuid())
  /// Anchored at local noon so no timezone can shift it. Use lib dayKey helpers.
  date     DateTime @unique
  open     Boolean  @default(true)
  /// Max jobs on this day. Null = template capacity.

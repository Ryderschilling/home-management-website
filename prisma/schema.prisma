model SquareLink {
  squareCustomerId String @id
  clientId         String
  client           Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Tiny key-value store (last Square sync time, etc).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


// ============================================================================
// HOMEOWNER PORTAL (added 2026-09-23)
//
// Clients log in on the public website, pick a plan and visit days, pay through
// Square, and the result lands here as Orders, Jobs and Payments. The website
// carries a verbatim copy of this schema (scripts/sync-schema.mjs over there).
// THIS FILE IS THE OWNER. Never run migrate or db push from the website repo.
// ============================================================================

/// Who created a Job. CALENDAR = pulled from Google, MANUAL = typed in CHM Ops,
/// PORTAL = a client ordered it on the website.
enum JobSource {
  CALENDAR
  MANUAL
  PORTAL
}

/// PLAN bills monthly on autopay. ADDON is a fixed price charged at checkout.
/// REQUEST has no fixed price: the client books the day and describes the work,
/// Ryder quotes it, nothing is charged by the portal.
enum ServiceKind {
  PLAN
  ADDON
  REQUEST
}

enum ServiceUnit {
  MONTH
  DAY
  VISIT
  EACH
}

/// DRAFT is the cart. PENDING means checkout started (or a REQUEST order that
/// carries no charge). PAID is money in. FAILED is a declined card.
enum OrderStatus {
  DRAFT
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PlanTerm {
  MONTHLY
  LOCK12
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

/// A client's portal login. One per client, matched on email at signup.
model PortalUser {
  id              String    @id @default(cuid())
  clientId        String    @unique
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email           String    @unique
  /// scrypt hash, see lib/portal/password.ts. Never bcrypt, no extra library.
  passwordHash    String
  emailVerifiedAt DateTime?
  verifyCode      String?
  verifyExpires   DateTime?
  resetToken      String?   @unique
  resetExpires    DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions PortalSession[]
}

/// A row per browser login. The id is the cookie value. Deleting the row logs
/// that browser out, which is how "log out everywhere" works.
model PortalSession {
  id        String     @id
  userId    String
  user      PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Login and code-entry throttling without Redis. key = "login:<email>" etc.
model PortalRateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// THE PRICE LIST. The portal tiles, the checkout math, and (eventually) the
/// public pricing page all read from here. Change a price once.
model ServiceCatalog {
  code           String      @id
  name           String
  blurb          String?
  kind           ServiceKind
  unit           ServiceUnit @default(EACH)
  /// Public price. For a PLAN this is the month-to-month rate.
  price          Decimal     @db.Decimal(10, 2)
  /// PLAN only: the 12-month locked monthly rate.
  lock12Price    Decimal?    @db.Decimal(10, 2)
  /// ADDON only: the cheaper price a client on an active plan pays (storm check $50 vs $100).
  planPrice      Decimal?    @db.Decimal(10, 2)
  /// PLAN only: visits the client may pick per month.
  visitsPerMonth Int?
  requiresPlan   Boolean     @default(false)
  /// What the crew sees as jobType on the Job row.
  jobType        String?
  /// The one question the popup asks for this service (label shown to the client).
  questionLabel  String?
  questionHint   String?
  active         Boolean     @default(true)
  sort           Int         @default(0)
  /// Square catalog ids, created on first use by lib/portal/square.ts.
  squarePlanId               String?
  squareVariationMonthlyId   String?
  squareVariationLock12Id    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/// One row per calendar day Ryder has explicitly opened or closed. Days with no

  /// Why a FAILED order failed, straight from Square.
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  lines    OrderLine[]
  payments Payment[]

  @@index([clientId, status])
}

/// One thing bought. A plan produces one line per picked visit day plus one
/// PLAN line for the subscription itself. An add-on produces one line per day.
model OrderLine {
  id             String            @id @default(cuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceCode    String
  /// Snapshots at order time, so a later price change never rewrites history.
  name           String
  kind           ServiceKind
  qty            Int               @default(1)
  unitPrice      Decimal           @db.Decimal(10, 2)
  amount         Decimal           @db.Decimal(10, 2)
  /// The visit day for this line. Null on the PLAN line itself.
  scheduledDate  DateTime?
  planTerm       PlanTerm?
  /// The popup answers, verbatim. Copied onto the Job notes so the crew sees them.
  details        Json?
  jobId          String?           @unique
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   PlanSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([orderId])
}

/// A client's plan. Portal-created ones carry a Square subscription. Legacy
/// clients get a row with their contracted rate and no Square id, so the portal
/// shows "Your rate: $135/mo, locked through Jun 2027" and counts their visits.
model PlanSubscription {
  id                   String             @id @default(cuid())
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId           String?
  property             Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  serviceCode          String
  serviceName          String
  term                 PlanTerm           @default(MONTHLY)
  rate                 Decimal            @db.Decimal(10, 2)
  visitsPerMonth       Int                @default(2)
  /// 0 = Sunday ... 6 = Saturday. Null = client picks by hand every month.
  preferredWeekday     Int?
  /// Which weeks of the month on a 12-month plan: [1,3] = 1st and 3rd, [2,4] = 2nd and 4th,
  /// [] = every week. Month-to-month plans pick exact days instead and leave this empty.
  weekOrdinals         Int[]              @default([])
  /// Month-to-month only: when the "renew for next month" email went out, so it goes once.
  renewalReminderAt    DateTime?
  startDate            DateTime
  endDate              DateTime?
  status               SubscriptionStatus @default(ACTIVE)
  squareSubscriptionId String?            @unique
  squareCustomerId     String?
  squareCardId         String?
  /// Set by the Square webhook on a failed autopay. Cleared when it clears.
  lastPaymentFailedAt  DateTime?
  canceledAt           DateTime?
  cancelReason         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  jobs  Job[]
  lines OrderLine[]

  @@index([clientId, status])
}

/// The service agreement, versioned. Bump the version when the words change so
/// every acceptance points at the exact text the client saw.
model AgreementVersion {
  version     String   @id
  title       String
  /// Markdown-ish plain text. Rendered as paragraphs in the checkout scroll box.
  body        String
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model AgreementAcceptance {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version    String
  orderId    String?
  acceptedAt DateTime @default(now())
  ip         String?
  typedName  String
  userAgent  String?

  @@index([clientId])
}
